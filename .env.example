# ==============================================================================
# CineStories / MoviePulse Configuration Environment Variables
# ==============================================================================

# 1. Target Deployment Domain (no trailing slash)
# Used for canonical tags, schema.org JSON-LD, sitemap URLs, and absolute asset paths
DOMAIN_NAME=https://cinestories.pages.dev

# 2. Site Identity & Branding
SITE_NAME=MoviePulse
SITE_TAGLINE=Visual Web Stories for Movie Lovers
PUBLISHER_NAME=MoviePulse

# 3. The Movie Database (TMDB) API Key or Read Access Token (v4)
# Get yours free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# 4. Google Gemini API Key
# Get yours at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 5. Gemini Model (Recommended: gemini-3.8-flash or gemini-flash-latest)
GEMINI_MODEL=gemini-3.8-flash

# 6. Pipeline Settings
STORIES_PER_CATEGORY_LIMIT=5
MAX_TOTAL_STORIES=15
